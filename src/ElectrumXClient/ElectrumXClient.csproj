<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <VersionPrefix>1.0.0</VersionPrefix>
        <PackageId>NorthGomel.ElectrumXClient</PackageId>
        <RootNamespace>NorthGomel.ElectrumXClient</RootNamespace>
        <AssemblyName>NorthGomel.ElectrumXClient</AssemblyName>
        <Authors>eudjien</Authors>
        <Description>A .NET Standard 2.1 client for Electrum Cash Protocol servers, with typed JSON-RPC APIs, TCP/TLS/WebSocket transports, and support for Dash masternode extensions.</Description>
        <Copyright>Copyright (c) Eugene Pinchuk 2026</Copyright>
        <PackageProjectUrl>https://github.com/eudjien/ElectrumXClient</PackageProjectUrl>
        <RepositoryUrl>https://github.com/eudjien/ElectrumXClient</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>ElectrumCashProtocol;ElectrumCash;BitcoinCash;BCH;ElectrumX;Dash;Masternode;ProTx;dotnet</PackageTags>
        <LangVersion>14.0</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ElectrumXClient.IntegrationTests"/>
        <ProjectReference Include="..\ElectrumXClient.Abstractions\ElectrumXClient.Abstractions.csproj"/>
        <PackageReference Include="System.Text.Json" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\icon.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
