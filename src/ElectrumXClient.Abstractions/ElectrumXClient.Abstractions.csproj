<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix>rc-1</VersionSuffix>
        <PackageId>NorthGomel.ElectrumXClient.Abstractions</PackageId>
        <RootNamespace>NorthGomel.ElectrumXClient.Abstractions</RootNamespace>
        <AssemblyName>NorthGomel.ElectrumXClient.Abstractions</AssemblyName>
        <Authors>eudjien</Authors>
        <Description>Shared Electrum Cash Protocol JSON-RPC method names, wire-format models, client contracts, and exceptions for ElectrumX-compatible .NET clients.</Description>
        <Copyright>Copyright (c) Eugene Pinchuk 2026</Copyright>
        <PackageProjectUrl>https://github.com/eudjien/ElectrumXClient</PackageProjectUrl>
        <RepositoryUrl>https://github.com/eudjien/ElectrumXClient</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>ElectrumCashProtocol;ElectrumCash;BitcoinCash;BCH;ElectrumX;protocol-models;client-contracts;Dash;ProTx;dotnet</PackageTags>
        <LangVersion>14.0</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="NorthGomel.ElectrumXClient"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\icon.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
